# -------------------------------------------------------------
# Modular Campus Hub - Environment Configuration
# Hacktoberfest Hack Day Jaunpur (Prasad Institute of Technology)
# -------------------------------------------------------------

# Google AI Studio API Key ($0 Free Tier, no credit card required)
# Get yours at https://aistudio.google.com/
# Leave empty to use built-in Zero-Key Local Grounded Preview mode
GEMINI_API_KEY=

# Backboard API Key (Optional $5 free Hacktoberfest sponsor credit, no credit card required)
# Get yours at https://app.backboard.io/
# When left empty, Campus Hub seamlessly uses local JSON persistent threads
BACKBOARD_API_KEY=

# Team Knowledge Studio Passcode (protects document uploads/deletes)
# Default demo passcode for judges: pit2026
TEAM_PASSCODE=pit2026

# Local storage path (Strictly on D: external SSD)
DATA_DIR=./data

# Disable Next.js telemetry (zero writes to C:)
NEXT_TELEMETRY_DISABLED=1
